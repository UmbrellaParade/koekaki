<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Koekaki" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/koekaki_setup_background</item>
        <item name="android:statusBarColor">@color/koekaki_setup_background</item>
        <item name="android:navigationBarColor">@color/koekaki_setup_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/koekaki_primary</item>
    </style>

    <style name="TextAppearance.Koekaki.Title" parent="@android:style/TextAppearance.Material.Headline">
        <item name="android:textColor">@color/koekaki_text_primary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Koekaki.Heading" parent="@android:style/TextAppearance.Material.Subhead">
        <item name="android:textColor">@color/koekaki_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Koekaki.Body" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">@color/koekaki_text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextAppearance.Koekaki.Status" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Koekaki.Caption" parent="@android:style/TextAppearance.Material.Caption">
        <item name="android:textColor">@color/koekaki_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Widget.Koekaki.Button.Base" parent="@android:style/Widget.Material.Button">
        <item name="android:backgroundTint">@null</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Koekaki.Button.Primary" parent="Widget.Koekaki.Button.Base">
        <item name="android:background">@drawable/bg_setup_button_primary</item>
        <item name="android:textColor">@color/koekaki_button_text</item>
    </style>

    <style name="Widget.Koekaki.Button.Secondary" parent="Widget.Koekaki.Button.Base">
        <item name="android:background">@drawable/bg_setup_button_secondary</item>
        <item name="android:textColor">@color/koekaki_text_primary</item>
    </style>
</resources>
